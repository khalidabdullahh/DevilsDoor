{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/game", "destination": "/game.html" },
    { "source": "/game/", "destination": "/game.html" },
    { "source": "/play", "destination": "/play.html" },
    { "source": "/play/", "destination": "/play.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
